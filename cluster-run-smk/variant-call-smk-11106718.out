Shell command: 
        # GenomicsDB writes many small files: keep it on the node's own disk (mktemp -d),
        # not in work/, which on Explorer is the network home folder.
        (tmp=$(mktemp -d)
        trap 'rm -rf $tmp' EXIT
        gatk GenomicsDBImport -V work/gvcf/NA12878.g.vcf.gz -V work/gvcf/NA12891.g.vcf.gz -V work/gvcf/NA12892.g.vcf.gz -V work/gvcf/NA07357.g.vcf.gz -V work/gvcf/NA12003.g.vcf.gz -V work/gvcf/NA10851.g.vcf.gz -V work/gvcf/NA12813.g.vcf.gz -V work/gvcf/NA12873.g.vcf.gz --genomicsdb-workspace-path $tmp/genomicsdb -L chr20:1-10000000
        gatk GenotypeGVCFs -R /courses/BINF6610.202710/data/refs/grch38-1000g/GRCh38_full_analysis_set_plus_decoy_hla.fa -V gendb://$tmp/genomicsdb -O work/joint/cohort.vcf.gz
        n_cols=$(gzip -dc work/joint/cohort.vcf.gz | awk -F'\t' '/^#CHROM/ { n = NF - 9 } END { print n + 0 }')
        echo "cohort VCF has $n_cols sample columns for 8 samples"
        [ $n_cols -eq 8 ]) > logs/joint_genotype.log 2>&1
        
