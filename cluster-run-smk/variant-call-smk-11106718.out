Shell command: 
        (gatk VariantFiltration -R /courses/BINF6610.202710/data/refs/grch38-1000g/GRCh38_full_analysis_set_plus_decoy_hla.fa -V work/joint/cohort.vcf.gz -O results/cohort.filtered.vcf.gz \
            --filter-expression "QD < 2.0"    --filter-name QD2 \
            --filter-expression "QUAL < 30.0" --filter-name QUAL30 \
            --filter-expression "FS > 60.0"   --filter-name FS60 \
            --filter-expression "SOR > 3.0"   --filter-name SOR3 \
            --filter-expression "MQ < 40.0"   --filter-name MQ40
        n_in=$(gzip -dc work/joint/cohort.vcf.gz | awk '!/^#/ { n++ } END { print n + 0 }')
        n_out=$(gzip -dc results/cohort.filtered.vcf.gz | awk '!/^#/ { n++ } END { print n + 0 }')
        echo "filtering: $n_in records in, $n_out out"
        [ $n_in -eq $n_out ]
        printf 'chrom\tpos\tref\talt\tqual\tfilter\n' > results/variants.tsv
        bcftools query -f '%CHROM\t%POS\t%REF\t%ALT\t%QUAL\t%FILTER\n' results/cohort.filtered.vcf.gz >> results/variants.tsv) > logs/filter.log 2>&1
        
