# slurm/conf/slurm.env — everything that is true only on Explorer.
# Read with `source` by submit.sh and by both job scripts. NAME=value lines only.
PARTITION=courses
ACCOUNT=binf6610.202710
USER=${USER:-$(id -un)}                      # a job may start without $USER set
SAMPLESHEET=/courses/BINF6610.202710/data/samplesheet-variant8.csv
PIPELINE_DIR=${HOME}/BINF6610                # the folder you cloned the repository into
RUN_ROOT=/scratch/${USER}/w3-run             # week 3: a new run directory, so every stage runs in the image
SIF=/scratch/${USER}/containers/variant-call.sif   # written by pull.sbatch
