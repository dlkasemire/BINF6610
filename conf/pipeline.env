# conf/pipeline.env configuration for run_pipeline.sh
set -euo pipefail

#Reference genome and calling region.
# This week: the smoke dataset. Next: Explorer paths.
: "${REF:=$HOME/Documents/Scientific_computing/smoke/smoke.fa}"
: "${REGION:=smoke_1mb}"

# Number of CPU cores each tool may use
: "${THREADS:=4}" 

# The condition column in this cohort is synthetic (made up for grouping).
# Published outputs must say so. Use true or false.
: "${CONDITION_IS_SYNTHETIC:=true}"
